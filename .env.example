# Sayana's own values. Do not copy a database URL, API key, Clerk app,
# Vercel project, or push keys from AthleteOS or any other app.

# Not read by this build. Sign-in is a per-browser device cookie.
# Leave blank. If Clerk is wired later, create a Sayana Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Sayana's own Neon Postgres database. Tables are created with a sayana_ prefix.
DATABASE_URL=

# OpenAI — speech-to-text, the short reply, Today notes, History answers.
# Leave OPENAI_MODEL empty to use gpt-6.1-sol. gpt-6-luna is the cheaper option.
OPENAI_API_KEY=
OPENAI_MODEL=

# Web Push (optional). Generate keys for Sayana: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. If set, /api/v1/reminders/tick requires Authorization: Bearer <this>.
# The cron in vercel.json does not send that header, so leave this empty
# unless you add the header yourself.
CRON_SECRET=

# Not read by this build. Leave blank. Do not reuse another app's OAuth client.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3100/api/v1/calendar/callback

# Not read by this build.
NEXT_PUBLIC_APP_URL=http://localhost:3100
